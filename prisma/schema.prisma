generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PasswordRecord {
  id         String   @id @default(uuid())
  userId     String
  site       String
  ciphertext String
  iv         String
  tag        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
